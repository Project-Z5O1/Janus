      "model": "zhipuai-coding-plan/glm-5.2",
      "thinking": {
        "type": "enabled"
      },
      "variant": "xhigh"
    }
  },
  "experimental": {
    "task_system": true,
    "dynamic_context_pruning": {
      "enabled": true,                  // enable startup-state pruning
      "notification": "minimal",        // "off" (no prompt), "minimal" (short prompt), "detailed" (list pruned logs in detail)
      "turn_protection": {
        "enabled": true,
        "turns": 5                      // never clean up the last 5 turns of conversation data
      },
      // never clean up results from these especially important tools (edit and task-state tools are protected by default)
      "protected_tools": [
        "task",
        "todowrite",
        "todoread",
        "lsp_rename" // plus any other tool names whose context should be kept for every request
      ]
    }
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical"
  },
  "ralph_loop": {
    "enabled": true,
    "default_max_iterations": 1000
  },
  "background_task": {
    "maxDepth": 5,        // set maximum subtask nesting depth to 5 (default is 3)
    "maxDescendants": 1000, // set maximum background subagents derived from one conversation to 1000 (default is 50)
    // 3. Limit concurrency by specific model ID (highest priority)
    "modelConcurrency": {
      "xxxxx": 2   // separate concurrency setting for a domestic large model
    }
  }
}
